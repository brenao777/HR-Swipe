# All variables are OPTIONAL — the app runs with sensible dev defaults.
# Copy to .env only if you want to override them.

# Port the API listens on (default: 3000)
PORT=3000

# Allowed origin for CORS / websockets (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Path to the SQLite file (default: db/hr-swipe.sqlite)
DB_STORAGE=

# JWT secrets — set these in production!
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
